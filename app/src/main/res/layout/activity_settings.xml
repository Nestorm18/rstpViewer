<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="560dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            style="@style/Title"
            android:text="@string/settings_title" />

        <TextView style="@style/Label" android:text="@string/ip" />
        <EditText
            android:id="@+id/ip"
            style="@style/Field"
            android:hint="192.168.1.64"
            android:inputType="textUri" />

        <TextView style="@style/Label" android:text="@string/port" />
        <EditText
            android:id="@+id/port"
            style="@style/Field"
            android:hint="554"
            android:inputType="number" />

        <TextView style="@style/Label" android:text="@string/user" />
        <EditText
            android:id="@+id/user"
            style="@style/Field"
            android:hint="admin"
            android:inputType="text" />

        <TextView style="@style/Label" android:text="@string/pass" />
        <EditText
            android:id="@+id/pass"
            style="@style/Field"
            android:inputType="textPassword" />

        <TextView style="@style/Label" android:text="@string/path" />
        <EditText
            android:id="@+id/path"
            style="@style/Field"
            android:hint="/Streaming/Channels/101"
            android:inputType="textUri" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/path_help"
            android:textColor="#9E9E9E"
            android:textSize="13sp" />

        <TextView style="@style/Label" android:text="@string/backup_text" />
        <EditText
            android:id="@+id/backup_text"
            style="@style/Field"
            android:hint="@string/backup_text_hint"
            android:inputType="textCapSentences"
            android:maxLength="500" />

        <CheckBox
            android:id="@+id/tcp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/tcp"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <CheckBox
            android:id="@+id/autostart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/autostart"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <LinearLayout
            android:id="@+id/autostart_permission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/grant_autostart_help"
                android:textColor="#FFB74D"
                android:textSize="14sp" />

            <Button
                android:id="@+id/grant_autostart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/grant_autostart" />
        </LinearLayout>

        <Button
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/save"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#757575"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/remote_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#29B6F6"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
